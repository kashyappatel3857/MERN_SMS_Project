{
  "name": "student-attendance-management-system",
  "version": "1.0.0",
  "description": "Student Attendance Management System built with MongoDB, Express.js, React.js (Vite), and Node.js (MERN Stack)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "seed": "cd backend && npm run seed",
    "seed:destroy": "cd backend && npm run seed:destroy",
    "build:frontend": "cd frontend && npm run build"
  },
  "keywords": [
    "mern",
    "mongodb",
    "express",
    "react",
    "nodejs",
    "attendance-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
